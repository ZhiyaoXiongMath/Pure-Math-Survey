# Runtime text has deterministic bytes on Windows and Unix so the source
# resource checksum list remains verifiable after checkout. Binary and
# explicitly preserved reference/example files retain their original bytes.
skills/pure-math-survey/** text=auto eol=lf

# Example snapshots, materials and reviews contain hashes of exact stored bytes.
# Preserve their Git blob bytes on Windows as well as Unix checkouts.
examples/** -text whitespace=cr-at-eol
