\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{math-review}[2026/10/21 v2.4.1 Pure Math Survey style]

% rules.v22 with the minimal-runtime adaptation.
% Use with \documentclass[11pt,reqno]{amsart}. Keep this file beside the TeX.
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\IfFileExists{stix2.sty}{\RequirePackage{stix2}}{%
  \IfFileExists{lmodern.sty}{\RequirePackage{lmodern}}{}%
  \PackageWarningNoLine{math-review}{STIX2 unavailable; using the installed fallback fonts}%
}
\IfFileExists{microtype.sty}{\RequirePackage{microtype}}{}
\RequirePackage{geometry}
\geometry{a4paper,textwidth=6.1in,top=1.2in,bottom=1.2in,
  headheight=14pt,headsep=0.2in,footskip=0.5in}
\RequirePackage{enumitem,needspace}
% Use lists for independent hypotheses; these are readable gaps, not a length hack.
\setlist[enumerate]{leftmargin=*,label=\textup{(\roman*)},
  topsep=0.35\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}
\setlist[itemize]{leftmargin=*,
  topsep=0.35\baselineskip,itemsep=0.15\baselineskip,parsep=0pt}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue,
  linktocpage=true,bookmarksnumbered=true,bookmarksdepth=2}
\linespread{1}
\emergencystretch=1.2em
\widowpenalty=10000
\clubpenalty=10000
\pagestyle{plain}
\setcounter{tocdepth}{1}
\numberwithin{equation}{section}

\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{conjecture}[theorem]{Conjecture}
% Useful full recalls keep the original theorem number and reuse a label-free body.
% Usage: \begin{theoremrecall}{thm:main}\input{canonical/main.tex}\end{theoremrecall}
% Put no \label inside the recall; reference the primary theorem's label instead.
\newcommand{\mathreviewrecallheading}{Theorem}
\newtheorem*{mathreviewrecalledtheorem}{\mathreviewrecallheading}
\newenvironment{theoremrecall}[1]{%
  \renewcommand{\mathreviewrecallheading}{Theorem~\ref{#1} (recalled)}%
  \begin{mathreviewrecalledtheorem}%
}{\end{mathreviewrecalledtheorem}}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\newtheorem{problem}[theorem]{Problem}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% Visible scaffold content, never publication content. A published review contains
% no \placeholder calls. Do not replace a placeholder with an invented result.
\newcommand{\placeholder}[1]{\par\noindent[INSERT: #1]}
\newcommand{\templatereferences}{%
  \section*{References}%
  \placeholder{Replace this paragraph with the bibliography of sources actually
  cited in this part. Give exact versions when a result or proof depends on
  them. Use real citation keys and verified bibliographic data.}%
}

% Normal substantive graph type; coordinates and labels remain editable.
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric}
\tikzset{pmsgraph/.style={font=\fontsize{10.5}{13}\selectfont},
 pmsresult/.style={draw,rounded corners,align=center,text width=3.8cm,inner sep=5pt},
 pmsjoin/.style={draw,ellipse,align=center,inner sep=4pt},
 pmsedge/.style={-{Stealth},line width=0.5pt},
 pmsunresolved/.style={dashed,line width=0.5pt},
 pmsannotation/.style={align=left,text width=3.5cm,inner sep=3pt},
 pmsattachment/.style={dotted,line width=0.5pt}}
\newcommand{\pmsattribution}[1]{\par\Needspace{5\baselineskip}\noindent #1\par\nobreak}
% Flush all body floats before observing the last main page. Do not reset page counters.
\newcommand{\pmsmainend}{\clearpage\typeout{PMS-MAIN-PAGES: \number\numexpr\value{page}-1\relax}}
\newcommand{\pmslayout}{%
 \typeout{PMS-BODY-FONT-PT: \f@size}%
 \typeout{PMS-BASELINE-PT: \the\baselineskip}%
 \typeout{PMS-LEFT-MARGIN-PT: \the\dimexpr1in+\hoffset+\oddsidemargin\relax}%
 \typeout{PMS-RIGHT-MARGIN-PT: \the\dimexpr\paperwidth-1in-\hoffset-\oddsidemargin-\textwidth\relax}%
 \typeout{PMS-TOP-MARGIN-PT: \the\dimexpr1in+\voffset+\topmargin+\headheight+\headsep\relax}%
 \typeout{PMS-BOTTOM-MARGIN-PT: \the\dimexpr\paperheight-1in-\voffset-\topmargin-\headheight-\headsep-\textheight\relax}}
